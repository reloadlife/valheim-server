# Copy to .env and edit. Every value here is optional except SERVER_PASSWORD.

# --- Identity -----------------------------------------------------------------
# Shown in the server browser. Must NOT contain the password.
SERVER_NAME=My Valheim Server

# Save file name. Changing this starts a brand new world.
WORLD_NAME=Dedicated

# World seed, e.g. "Meadows42". Alphanumeric, 1-10 chars.
# Only applies when the world is FIRST created — the seed is baked into the world
# forever after. To reseed, change WORLD_NAME or delete data/worlds_local/<name>.*
# Leave empty for a random seed.
WORLD_SEED=

# Required for a public server. Minimum 5 characters, cannot appear in SERVER_NAME.
SERVER_PASSWORD=changeme

# --- Networking ---------------------------------------------------------------
# UDP. The server also uses SERVER_PORT+1 for Steam queries — keep the two in sync.
SERVER_PORT=2456
SERVER_QUERY_PORT=2457

# 1 = listed in the public community browser, 0 = join by IP / Steam invite only.
SERVER_PUBLIC=1

# true = allow Xbox/Game Pass/PlayStation players (uses PlayFab instead of Steam).
CROSSPLAY=false

# --- Who can join -------------------------------------------------------------
# SteamID64 per player, comma or space separated. Find yours at steamid.io.
# With CROSSPLAY=true, console players use the Platform_ID form: Xbox_2533274801742044
#
# Admins: /kick /ban /save /skiptime etc. in-game (press F5 for the console).
ADMIN_IDS=76561198356929826

# Blocked from joining.
BANNED_IDS=

# ALLOWLIST. Leave EMPTY for a normal password-protected server.
# Setting even one ID here bans everyone not listed — this is the switch itself,
# there is no separate enable flag.
PERMITTED_IDS=

# --- World rules --------------------------------------------------------------
# One of: normal, casual, easy, hard, hardcore, immersive, hammer. Empty = normal.
SERVER_PRESET=

# Fine-grained overrides, space separated name=value. Applied on top of SERVER_PRESET.
#   combat=veryeasy|easy|hard|veryhard
#   deathpenalty=casual|veryeasy|easy|hard|hardcore
#   resources=muchless|less|more|muchmore|most
#   raids=none|muchless|less|more|muchmore
#   portals=casual|hard|veryhard
# Example: WORLD_MODIFIERS=combat=hard raids=none portals=casual
WORLD_MODIFIERS=

# Boolean world toggles, space separated. Any of:
#   nobuildcost playerevents passivemobs nomap
WORLD_KEYS=

# Seconds between world autosaves.
SAVE_INTERVAL=1800

# Extra raw flags appended to the server command line, e.g. "-instanceid 1".
SERVER_ARGS=

# --- Maintenance --------------------------------------------------------------
# Pull the latest server build from Steam on every container start.
UPDATE_ON_START=true

# Verify every file on update. Slow — turn on only when you suspect corruption.
VALIDATE_ON_UPDATE=false

# Opt into a Steam beta branch (e.g. public-test). Empty = stable.
STEAM_BETA=

# Built-in rolling backups written next to the world in ./data.
BACKUPS=true
BACKUP_SHORT=7200
BACKUP_LONG=43200
